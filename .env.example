# Docker Image (set by CI/CD - leave as is)
DOCKER_IMAGE=ghcr.io/YOUR_GITHUB_USERNAME/YOUR_REPO
IMAGE_TAG=latest

# Database
POSTGRES_USER=root
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=bimmingo
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=bimmingo
RABBITMQ_PASS=CHANGE_ME_STRONG_PASSWORD

# Telegram (get from @BotFather)
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN

# Daemon
DAEMON_INTERVAL_MINUTES=15

# Buyer request limits
MAX_REQUESTS_FREE=3
MAX_REQUESTS_BASIC=5
MAX_REQUESTS_PREMIUM=10
MAX_REQUESTS_ENTERPRISE=999

# Seller listing limits
MAX_LISTINGS_FREE=5
MAX_LISTINGS_BASIC=15
MAX_LISTINGS_PREMIUM=50
MAX_LISTINGS_ENTERPRISE=999

# Support
SUPPORT_EMAIL=support@bimmingo.com
SUPPORT_PHONE=+355 69 57 04 173
SUPPORT_TELEGRAM=@BimmingoBot